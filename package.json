{
  "name": "@passport-next/chai-connect-middleware",
  "version": "2.0.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    "types": "./types/index.d.ts",
    "default": "./lib/index.js"
  },
  "description": "Helpers for testing Connect middleware with the Chai assertion library.",
  "author": {
    "name": "Passport Next Developers",
    "url": "https://github.com/orgs/passport-next/people"
  },
  "homepage": "https://github.com/passport-next/chai-connect-middleware",
  "contributors": [],
  "bugs": {
    "url": "https://github.com/passport-next/chai-connect-middleware/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "chai": "6.x.x",
    "coveralls": "^3.1.1",
    "eslint": "^10.8.1",
    "eslint-config-ash-nazg": "^42.3.1",
    "mocha": "^11.8.0",
    "nunjucks": "^3.2.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "keywords": [
    "express",
    "connect",
    "auth",
    "authn",
    "authentication"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/passport-next/chai-connect-middleware"
  },
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm tsc",
    "tsc": "tsc",
    "attw": "attw --pack . --profile esm-only node16",
    "build": "tsc -p tsconfig-prod.json && pnpm attw",
    "templates": "node ./templates/gen.js",
    "init-new-project": "node ./templates/gen --init",
    "lint": "eslint --max-warnings 0 --ext js,cjs,md .",
    "lintfix": "eslint --ext js,md . --fix",
    "testonly": "mocha --reporter spec test/*.test.js test/**/*.test.js",
    "test": "c8 --report-dir=var/coverage --reporter=lcov --reporter=text npm run testonly",
    "coveralls": "c8 report --report-dir=var/coverage --reporter=text-lcov | coveralls"
  }
}
